#!/bin/bash

PROG=$(basename ${0})

function usage() {
    echo "Usage:"
    echo "  ${PROG} start|stop|status"
}

if [ ${#} -ne 1 ]; then
    usage
    exit 1
fi

# set -x
case ${1} in
    start)
      cd ~ocs/python/WAO_Safety
      source venv/bin/activate
      python3 ${OPTIONS} ~ocs/python/WAO_Safety/main.py >/dev/null 2>&1
      ;;

    stop)
      pkill -9 -f WAO_Safety/main.py
      exit 0
      ;;

    status)
      ;;

    *)
      usage
      exit 1
esac
